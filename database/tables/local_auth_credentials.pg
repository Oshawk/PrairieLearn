columns
    password_hash: text not null
    updated_at: timestamp with time zone not null default CURRENT_TIMESTAMP
    user_id: bigint not null

indexes
    local_auth_credentials_pkey: PRIMARY KEY (user_id) USING btree (user_id)

foreign-key constraints
    local_auth_credentials_user_id_fkey: FOREIGN KEY (user_id) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE
